{
  "name": "pulsar",
  "version": "0.1.0",
  "description": "A physical GitHub status light over USB — macOS menu bar app.",
  "author": "Matthieu Balmes",
  "main": "dist/electron-main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc && node scripts/copy-renderer.js",
    "start": "node dist/index.js",
    "app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac",
    "icons": "node scripts/gen-tray-icons.js",
    "verify:serial": "electron scripts/verify-serialport.js",
    "rebuild": "electron-rebuild",
    "arduino": "open -a 'Arduino IDE' ../arduino/led_controller/led_controller.ino",
    "postinstall": "node scripts/install-icon.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^21.0.0",
    "dotenv": "^16.0.0",
    "node-notifier": "^10.0.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.0.0",
    "@types/node-notifier": "^8.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
